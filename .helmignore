# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Helm
.helmignore
# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
# Documentation source
docs/
# Test files
tests/
*_test.go
# Development files
Makefile
Dockerfile
docker-compose*.yml
# Secrets (never package these)
secrets/
*.pem
*.key
*.crt
# Other
CHANGELOG.md
# Note: Keep README.md and LICENSE - Artifact Hub uses them
